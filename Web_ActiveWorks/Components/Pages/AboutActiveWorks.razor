@page "/"
@page "/about-activeworks"
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>Про ActiveWorks — Робочий центр для поліграфічних замовлень</PageTitle>

<!-- HERO SECTION З ІНТЕРАКТИВНИМ СИМУЛЯТОРОМ -->
<section class="presentation-hero">
    <div class="presentation-hero-content">
        <div class="hero-top-badges">
            <span class="presentation-badge">ActiveWorks</span>
            <span class="live-pulse-badge"><span class="pulse-dot"></span> Інтерактивний огляд</span>
        </div>
        <h1>Робочий центр для поліграфічних замовлень</h1>
        <p>
            ActiveWorks об'єднує замовлення, робочі файли, статуси, FTP-обмін,
            Signa Station та набір препрес-інструментів у єдине робоче місце.
            Більше ніяких загублених макетів, нескінченних перемикань між провідниками
            чи рутинних PDF-операцій вручну.
        </p>

        <div class="hero-stats-mini">
            <div class="mini-stat-item">
                <span class="mini-stat-val">20+</span>
                <span class="mini-stat-lbl">PDF-утиліт</span>
            </div>
            <div class="mini-stat-item">
                <span class="mini-stat-val">1 клік</span>
                <span class="mini-stat-lbl">До Signa & папок</span>
            </div>
            <div class="mini-stat-item">
                <span class="mini-stat-val">0</span>
                <span class="mini-stat-lbl">Загублених файлів</span>
            </div>
        </div>

        <div class="presentation-actions">
            <a class="primary-action pulse-btn" href="/login?returnUrl=%2Fjobs">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
                Увійти в портал
            </a>
            <a class="secondary-action" href="#workflow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
                Як це працює
            </a>
            <a class="secondary-action" href="#tools">
                Інструменти PDF
            </a>
        </div>
    </div>

    <!-- ЖИВИЙ СИМУЛЯТОР РОБОЧОГО СТОЛУ -->
    <div class="presentation-snapshot-live">
        <div class="snapshot-header">
            <div class="snapshot-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
            </div>
            <div class="snapshot-title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                ActiveWorks &bull; @selectedProfile
            </div>
            <div class="snapshot-profile-select">
                <select @bind="selectedProfile" class="profile-dropdown">
                    <option value="Офсетний цех">Офсет</option>
                    <option value="Цифровий друк">Цифра</option>
                    <option value="Широкоформатний цех">Широкоформат</option>
                </select>
            </div>
        </div>

        <!-- ІНТЕРАКТИВНІ ВКЛАДКИ СИМУЛЯТОРА -->
        <div class="snapshot-nav">
            <button type="button" class="sim-tab @(activeSimTab == "jobs" ? "active" : "")" @onclick='() => SetSimTab("jobs")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                Замовлення
            </button>
            <button type="button" class="sim-tab @(activeSimTab == "files" ? "active" : "")" @onclick='() => SetSimTab("files")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                Файли & FTP
            </button>
            <button type="button" class="sim-tab @(activeSimTab == "pdf" ? "active" : "")" @onclick='() => SetSimTab("pdf")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                PDF-Дії
            </button>
            <button type="button" class="sim-tab @(activeSimTab == "plugins" ? "active" : "")" @onclick='() => SetSimTab("plugins")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                Плагіни
            </button>
        </div>

        <div class="snapshot-body">
            @if (activeSimTab == "jobs")
            {
                <div class="sim-content fade-in">
                    <div class="sim-toolbar-note">
                        <span>Активні роботи: <strong>3 в черзі</strong></span>
                        <span class="sim-hint">Клікніть роботу або змініть статус 👇</span>
                    </div>

                    <div class="sim-jobs-list">
                        @foreach (var job in demoJobs)
                        {
                            <div class="sim-job-card @(selectedJobId == job.Id ? "selected" : "")" @onclick="() => SelectJob(job.Id)">
                                <div class="sim-job-header">
                                    <span class="sim-job-number">№ @job.Number</span>
                                    <span class="sim-status-badge @job.StatusClass">@job.Status</span>
                                </div>
                                <div class="sim-job-title">@job.Title</div>
                                <div class="sim-job-client">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    @job.Client
                                    <span class="sim-job-meta">&bull; @job.Format, @job.Copies тир.</span>
                                </div>

                                @if (selectedJobId == job.Id)
                                {
                                    <div class="sim-job-quick-actions">
                                        <button type="button" class="sim-btn-action" @onclick="() => CycleJobStatus(job)">
                                            🔄 Змінити статус: <strong>@GetNextStatus(job.Status)</strong>
                                        </button>
                                        <button type="button" class="sim-btn-action outline" @onclick='() => SetSimTab("files")'>
                                            📂 Файли (@job.FileCount)
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeSimTab == "files")
            {
                <div class="sim-content fade-in">
                    <div class="sim-dual-pane">
                        <div class="sim-pane">
                            <div class="sim-pane-header">
                                <span class="pane-tag ftp">Клієнтський FTP</span>
                                <span class="pane-path">/incoming/agrobiz/</span>
                            </div>
                            <div class="sim-file-item @(ftpFileDownloaded ? "downloaded" : "")">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                <span class="file-name">katalog_v2_new_pages.pdf</span>
                                <span class="file-size">48 МБ</span>
                            </div>
                            <button type="button" class="sim-action-btn-mini @(ftpFileDownloaded ? "done" : "")" @onclick="SimulateFtpDownload">
                                @if (ftpFileDownloaded)
                                {
                                    <span>✓ Завантажено в замовлення</span>
                                }
                                else
                                {
                                    <span>📥 Затягнути в замовлення № 4821</span>
                                }
                            </button>
                        </div>

                        <div class="sim-pane">
                            <div class="sim-pane-header">
                                <span class="pane-tag local">Папка замовлення</span>
                                <span class="pane-path">D:/Jobs/2026/4821/</span>
                            </div>
                            <div class="sim-file-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                <span class="file-name">cover_4821_trim.pdf</span>
                                <span class="file-badge-ok">TrimBox OK</span>
                            </div>
                            @if (ftpFileDownloaded)
                            {
                                <div class="sim-file-item new-item fade-in">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                    <span class="file-name">katalog_v2_new_pages.pdf</span>
                                    <span class="file-badge-new">NEW</span>
                                </div>
                            }
                            <div class="sim-file-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                                <span class="file-name">4821_imposition.sig</span>
                                <span class="file-badge-signa">Signa 2026</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (activeSimTab == "pdf")
            {
                <div class="sim-content fade-in">
                    <div class="sim-pdf-tools-panel">
                        <div class="sim-pdf-instructions">
                            Швидкі операції над вибраним файлом макета:
                        </div>
                        <div class="sim-pdf-grid">
                            <button type="button" class="sim-pdf-btn @(lastExecutedPdfAction == "trimbox" ? "triggered" : "")" @onclick='() => ExecuteSimPdfAction("trimbox", "MediaBox вирівняно до TrimBox (210×297 мм + 2 мм вильоти)")'>
                                <span class="pdf-btn-icon">📐</span>
                                <span class="pdf-btn-title">TrimBox & Вильоти</span>
                                <span class="pdf-btn-sub">Приведення полів</span>
                            </button>

                            <button type="button" class="sim-pdf-btn @(lastExecutedPdfAction == "split" ? "triggered" : "")" @onclick='() => ExecuteSimPdfAction("split", "Файл розділено на: Обкладинка (4 стор.) та Блок (48 стор.)")'>
                                <span class="pdf-btn-icon">✂️</span>
                                <span class="pdf-btn-title">Розділити обкл/блок</span>
                                <span class="pdf-btn-sub">Для брошури</span>
                            </button>

                            <button type="button" class="sim-pdf-btn @(lastExecutedPdfAction == "barcode" ? "triggered" : "")" @onclick='() => ExecuteSimPdfAction("barcode", "Згенеровано QR-код та додано на 4-ту сторінку")'>
                                <span class="pdf-btn-icon">🏁</span>
                                <span class="pdf-btn-title">QR / Штрих-код</span>
                                <span class="pdf-btn-sub">Маркування тиражу</span>
                            </button>

                            <button type="button" class="sim-pdf-btn @(lastExecutedPdfAction == "signa" ? "triggered" : "")" @onclick='() => ExecuteSimPdfAction("signa", "Сигнатурний файл передано у Prinect Signa Station")'>
                                <span class="pdf-btn-icon">🖨️</span>
                                <span class="pdf-btn-title">Signa Station</span>
                                <span class="pdf-btn-sub">Спуск полос</span>
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(simActionMessage))
                        {
                            <div class="sim-action-toast fade-in">
                                <span class="toast-check">✓</span>
                                <span>@simActionMessage</span>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeSimTab == "plugins")
            {
                <div class="sim-content fade-in">
                    <div class="sim-plugins-list">
                        <div class="sim-plugin-row">
                            <div class="sim-plugin-info">
                                <div class="sim-plugin-name">Job Information Panel</div>
                                <div class="sim-plugin-desc">Швидкий перегляд технологічної карти та параметрів паперу</div>
                            </div>
                            <span class="sim-toggle-pill on">Увімкнено</span>
                        </div>
                        <div class="sim-plugin-row">
                            <div class="sim-plugin-info">
                                <div class="sim-plugin-name">Prinect Signa Bridge</div>
                                <div class="sim-plugin-desc">Експорт міток та геометрії друкарського аркуша у Signa</div>
                            </div>
                            <span class="sim-toggle-pill on">Увімкнено</span>
                        </div>
                        <div class="sim-plugin-row">
                            <div class="sim-plugin-info">
                                <div class="sim-plugin-name">Telegram Bot Notify</div>
                                <div class="sim-plugin-desc">Автоматичні повідомлення менеджеру при зміні статусу на «Готово»</div>
                            </div>
                            <span class="sim-toggle-pill off">Опційно</span>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="snapshot-footer">
            <span class="footer-tag">💡 Натискайте елементи симулятора для інтерактивної взаємодії</span>
        </div>
    </div>
</section>

<!-- ВИРОБНИЧИЙ КОНВЕЄР ЗАМОВЛЕННЯ (STEPPER) -->
<section id="workflow" class="presentation-section">
    <div class="section-heading">
        <span class="section-kicker">Виробничий конвеєр</span>
        <h2>Як ActiveWorks веде замовлення від файлу клієнта до друкарської машини</h2>
        <p class="section-lead">Клікніть будь-який етап нижче, щоб побачити, що саме автоматизує програма.</p>
    </div>

    <div class="workflow-stepper">
        @for (int i = 0; i < workflowSteps.Count; i++)
        {
            var stepIndex = i;
            var step = workflowSteps[i];
            <button type="button" class="workflow-step-btn @(currentWorkflowStep == stepIndex ? "active" : "")" @onclick="() => SetWorkflowStep(stepIndex)">
                <span class="step-num">@(stepIndex + 1)</span>
                <span class="step-label">@step.ShortTitle</span>
                <span class="step-icon">@step.Emoji</span>
            </button>
        }
    </div>

    <div class="workflow-details-panel">
        <div class="workflow-panel-header">
            <div class="step-tag-pill">Етап @(currentWorkflowStep + 1) з @workflowSteps.Count</div>
            <h3>@workflowSteps[currentWorkflowStep].FullTitle</h3>
        </div>
        <div class="workflow-panel-body">
            <div class="workflow-panel-col problem">
                <div class="col-head">
                    <span class="icon-bad">❌</span> Як це зазвичай роблять без ActiveWorks
                </div>
                <p>@workflowSteps[currentWorkflowStep].WithoutActiveWorks</p>
            </div>
            <div class="workflow-panel-col solution">
                <div class="col-head">
                    <span class="icon-good">✅</span> Як це працює з ActiveWorks
                </div>
                <p>@workflowSteps[currentWorkflowStep].WithActiveWorks</p>
                <div class="workflow-highlights">
                    @foreach (var hl in workflowSteps[currentWorkflowStep].Features)
                    {
                        <span class="hl-tag">@hl</span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ОСНОВНІ ПЕРЕВАГИ (КАРТКИ З СУЧАСНИМ ХОВЕРОМ) -->
<section class="presentation-section">
    <div class="section-heading">
        <span class="section-kicker">Основні переваги</span>
        <h2>Чому фахівці додрукарської підготовки обирають ActiveWorks</h2>
    </div>

    <div class="benefit-grid">
        <article class="benefit-card modern-card">
            <div class="card-icon-bubble teal">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            </div>
            <h3>Єдиний список робіт</h3>
            <p>Замовлення, замовник, опис, тираж, статус і пов'язані дії зібрані в одному структурованому списку без зайвих таблиць.</p>
        </article>

        <article class="benefit-card modern-card">
            <div class="card-icon-bubble blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
            </div>
            <h3>Керування статусами</h3>
            <p>Вся команда бачить актуальні етапи виконання замовлень у реальному часі. Налаштування статусів індивідуальні під кожен профіль.</p>
        </article>

        <article class="benefit-card modern-card">
            <div class="card-icon-bubble emerald">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <h3>Файли поруч із замовленням</h3>
            <p>Вбудовані файлові провідники, вкладки клієнтського FTP та швидкі дії усувають ручний пошук файлів на мережевих дисках.</p>
        </article>

        <article class="benefit-card modern-card">
            <div class="card-icon-bubble amber">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            </div>
            <h3>Інструменти для PDF</h3>
            <p>Понад 20 операцій з PDF: вильоти, TrimBox, спуск полос, розвороти, обкладинки, блоки та коди прямо у робочому процесі.</p>
        </article>

        <article class="benefit-card modern-card">
            <div class="card-icon-bubble purple">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            </div>
            <h3>Інтеграція з Prinect Signa</h3>
            <p>Створено з урахуванням Heidelberg Prinect Signa Station: передача параметрів спуску та збереження Signa-файлів у папку замовлення.</p>
        </article>

        <article class="benefit-card modern-card">
            <div class="card-icon-bubble rose">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
            </div>
            <h3>Плагінна архітектура</h3>
            <p>Можливість створювати модулі розширення: від виводу спеціальної інформації та сповіщень до кастомних розрахунків друкарні.</p>
        </article>
    </div>
</section>

<!-- PDF-ІНСТРУМЕНТИ З ЖИВИМ ФІЛЬТРОМ ТА ТЕГАМИ -->
<section id="tools" class="presentation-section">
    <div class="section-heading">
        <span class="section-kicker">PDF-інструменти</span>
        <h2>Не окремий PDF-редактор, а виробничий набір дій біля замовлення</h2>
        <p class="section-lead">Швидко відфільтруйте необхідні операції за напрямком підготовки макета:</p>
    </div>

    <!-- ФІЛЬТРИ ДЛЯ КАТЕГОРІЙ PDF -->
    <div class="category-filter-chips">
        @foreach (var cat in pdfCategories)
        {
            <button type="button" class="filter-chip @(selectedPdfCategory == cat.Key ? "active" : "")" @onclick="() => SetPdfCategory(cat.Key)">
                <span>@cat.Emoji</span>
                <span>@cat.Title</span>
                <span class="chip-count">@GetCategoryCount(cat.Key)</span>
            </button>
        }
    </div>

    <div class="pdf-feature-grid">
        @foreach (var item in FilteredPdfFeatures)
        {
            <article class="pdf-feature-panel modern-panel @(item.IsHighlight ? "highlight" : "")">
                <div class="panel-header-row">
                    <span class="panel-badge-icon">@item.Emoji</span>
                    <span class="panel-category-name">@item.CategoryLabel</span>
                </div>
                <h3>@item.Title</h3>
                <p>@item.Description</p>
                <div class="tag-badges-strip">
                    @foreach (var tag in item.Tags)
                    {
                        <span class="tech-tag">@tag</span>
                    }
                </div>
            </article>
        }
    </div>
</section>

<!-- ПОРІВНЯННЯ З АНАЛОГАМИ (ІНТЕРАКТИВНИЙ СЕЛЕКТОР + ТАБЛИЦЯ) -->
<section class="presentation-section">
    <div class="section-heading">
        <span class="section-kicker">Порівняння з аналогами</span>
        <h2>У чому перевага ActiveWorks</h2>
        <p class="section-lead">Оберіть альтернативне рішення, щоб побачити ключову різницю:</p>
    </div>

    <!-- ТАБИ ДЛЯ ШВИДКОГО ПОРІВНЯННЯ -->
    <div class="comparison-tabs">
        @for (int i = 0; i < comparisonList.Count; i++)
        {
            var idx = i;
            var comp = comparisonList[i];
            <button type="button" class="comp-tab-btn @(selectedComparisonIndex == idx ? "active" : "")" @onclick="() => SetComparisonIndex(idx)">
                <span class="comp-icon">@comp.Icon</span>
                <span class="comp-title">@comp.SystemType</span>
            </button>
        }
    </div>

    <!-- КАРТКА ПОРІВНЯННЯ ВИБРАНОЇ СИСТЕМИ -->
    <div class="comparison-spotlight">
        <div class="spotlight-col others">
            <div class="spotlight-header">
                <span class="spotlight-tag">Традиційний підхід</span>
                <h3>@comparisonList[selectedComparisonIndex].SystemType</h3>
            </div>
            <div class="spotlight-body">
                <div class="spotlight-section">
                    <strong>Що зазвичай робить добре:</strong>
                    <p>@comparisonList[selectedComparisonIndex].GoodAt</p>
                </div>
                <div class="spotlight-section limitation">
                    <strong>Вузьке місце на виробництві:</strong>
                    <p>@comparisonList[selectedComparisonIndex].Limitation</p>
                </div>
            </div>
        </div>

        <div class="spotlight-vs">
            <span class="vs-circle">VS</span>
        </div>

        <div class="spotlight-col activeworks">
            <div class="spotlight-header">
                <span class="spotlight-tag aw">Перевага ActiveWorks</span>
                <h3>Як це вирішує ActiveWorks</h3>
            </div>
            <div class="spotlight-body">
                <p class="aw-advantage-text">@comparisonList[selectedComparisonIndex].AwAdvantage</p>
                <div class="aw-key-points">
                    @foreach (var pt in comparisonList[selectedComparisonIndex].KeyPoints)
                    {
                        <div class="aw-point-item">
                            <span class="point-check">✓</span>
                            <span>@pt</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- КНОПКА РОЗГОРТАННЯ ПОВНОЇ ТАБЛИЦІ -->
    <div class="table-toggle-wrap">
        <button type="button" class="btn-toggle-table" @onclick="ToggleFullTable">
            @if (showFullTable)
            {
                <span>▲ Згорнути повну таблицю</span>
            }
            else
            {
                <span>▼ Показати зведену таблицю порівняння</span>
            }
        </button>
    </div>

    @if (showFullTable)
    {
        <div class="comparison-table-shell fade-in">
            <table class="comparison-table">
                <thead>
                    <tr>
                        <th>Тип рішення</th>
                        <th>Що зазвичай добре робить</th>
                        <th>Перевага ActiveWorks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in comparisonList)
                    {
                        <tr>
                            <td data-label="Тип рішення"><strong>@row.SystemType</strong></td>
                            <td data-label="Що добре робить">@row.GoodAt</td>
                            <td data-label="Перевага ActiveWorks">@row.AwAdvantage</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

